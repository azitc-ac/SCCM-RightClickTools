<?xml version="1.0" encoding="utf-8"?>
<!--
  ConfigMgr console extension: manage collection membership
  Location: %AdminConsolePath%\XmlStorage\Extensions\Actions\{a92615d6-9df3-49ba-a8c9-6ecb0e8b956b}\

  GUID a92615d6-9df3-49ba-a8c9-6ecb0e8b956b = a single device collection in the result pane
  (NOT the tree node DeviceCollectionsNode). Documented, stable constant.

  The placeholders ##SCRIPT_PATH##, ##EXT_PATH##, ##PATTERN_REQ##, ##PATTERN_AVL##
  are filled in by Install-Extension.ps1 (which also localises the menu entry).
-->
<ActionDescription
    Class="Executable"
    DisplayName="Manage Membership"
    MnemonicDisplayName="Manage Membership"
    Description="Manages which collections include this collection as a member (include rule)">
  <ShowOn>
    <string>ContextMenu</string>
  </ShowOn>
  <ImagesDescription>
    <ResourceAssembly>
      <Assembly>AdminUI.UIResources.dll</Assembly>
      <Type>Microsoft.ConfigurationManagement.AdminConsole.UIResources.Properties.Resources.resources</Type>
    </ResourceAssembly>
    <ImageResourceName>UpdateMembership</ImageResourceName>
  </ImagesDescription>
  <Executable>
    <FilePath>##EXT_PATH##\nopswindow.exe</FilePath>
    <Parameters>"##SCRIPT_PATH##" -CollectionID "##SUB:CollectionID##" -CollectionName "##SUB:Name##" -PatternRequired "##PATTERN_REQ##" -PatternAvailable "##PATTERN_AVL##"</Parameters>
  </Executable>
</ActionDescription>
